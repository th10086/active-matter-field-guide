---
import TrustPage from '../components/TrustPage.astro';
import site from '../data/site.json';
---
<TrustPage title="Terms of Service" description={`Read the conditions that apply when accessing, using and linking to the independent ${site.siteName} website.`}>
  <h2>Informational use</h2>
  <p>The site provides game information and walkthrough material for personal reference. Content may contain spoilers and may become outdated after a game update.</p>
  <h2>No guarantee</h2>
  <p>Reasonable care is taken when checking sources, but uninterrupted availability and complete accuracy cannot be guaranteed. Use the official game pages for purchasing, platform and support decisions.</p>
  <h2>Acceptable use</h2>
  <p>Do not attempt to disrupt the site, bypass security controls, scrape it in a way that harms availability, or republish substantial portions of its original writing as your own.</p>
  <h2>External services</h2>
  <p>The site may link to third-party services. Their availability, content and transactions are outside this site's control.</p>
  <h2>Changes</h2>
  <p>These terms may be revised when the site gains new features, advertising or additional contact methods.</p>
</TrustPage>
