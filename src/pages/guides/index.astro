---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import site from '../../data/site.json';
const guides = await getCollection('guides');
const title = `${site.gameName} Guides and Walkthroughs`;
const description = `Browse published ${site.gameName} walkthroughs and guides. Pages with unverified answers are withheld until their steps can be checked.`;
---
<BaseLayout title={title} description={description}>
  <div class="shell py-12 md:py-16">
    <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Guides' }]} />
    <p class="eyebrow">Published help only</p>
    <h1 class="mt-4 font-display text-4xl font-bold sm:text-5xl">{site.gameName} Guides</h1>
    <p class="mt-4 max-w-3xl text-lg text-muted">Choose a verified guide below. Full-game pages appear only after their answers have enough supporting material.</p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {guides.map((guide) => (
        <a href={`/${guide.data.slug}/`} class="site-card guide-card flex min-h-52 flex-col p-5 no-underline">
          <span class="text-xs font-bold uppercase tracking-wider text-primary">{guide.data.category}</span>
          <h2 class="mt-3 font-display text-xl font-bold">{guide.data.title}</h2>
          <p class="mt-3 text-sm text-muted">{guide.data.description}</p>
          <span class="mt-auto pt-5 text-sm font-bold text-primary">Read guide →</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
