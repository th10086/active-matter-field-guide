---
import BaseLayout from '../layouts/BaseLayout.astro';
import OfficialVideo from '../components/OfficialVideo.astro';
import site from '../data/site.json';
import home from '../data/home.json';

const { title, description, hero, video, guideCards, compare, stats, screenshots, bottomCta } = home;

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.siteName, url: site.siteUrl, description },
  { '@context': 'https://schema.org', '@type': 'VideoGame', name: site.gameName, url: site.officialUrl, datePublished: site.releaseDate, author: { '@type': 'Organization', name: site.developer }, publisher: { '@type': 'Organization', name: site.publisher }, gamePlatform: site.steamPlatforms.split(/,\s*/), applicationCategory: 'Game' },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="shell grid gap-10 py-20 md:grid-cols-[1.15fr_.85fr] md:items-center md:py-32">
    <div>
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 class="mt-6 max-w-4xl font-display text-5xl font-bold leading-[1.04] sm:text-6xl">{hero.headingPre} <span class="text-primary">{hero.headingHighlight}.</span></h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-muted">{hero.description}</p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a class="btn-primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
        {hero.secondaryCta && <a class="btn-secondary" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>}
      </div>
      <p class="mt-6 text-xs text-muted">{hero.disclaimer}</p>
    </div>
    {hero.image && (
      <aside aria-label="Official game screenshot">
        <figure class="site-card media-card overflow-hidden">
          <img src={hero.image.src} alt={hero.image.alt} width="1280" height="720" loading="eager" decoding="async" class="block aspect-video w-full object-cover" />
          <figcaption class="p-4 text-xs text-muted">{hero.image.caption}</figcaption>
        </figure>
        {hero.statusNote && <div class="status-note mt-4 rounded-r-lg p-4 text-sm">{hero.statusNote}</div>}
      </aside>
    )}
  </section>

  <section class="home-facts" aria-label="Verified game facts">
    <div><strong>Sep 15, 2026</strong><span>Steam launch date</span></div>
    <div><strong>PvE + PvP</strong><span>Dedicated modes confirmed</span></div>
    <div><strong>4 platforms</strong><span>Steam · Gaijin PC · PS5 · Xbox Series</span></div>
  </section>

  {video.videoId && (
    <section class="home-video-section shell grid gap-10 py-16 lg:grid-cols-[.8fr_1.2fr] lg:items-center" style="display:none">
      <div>
        <p class="eyebrow">{video.eyebrow}</p>
        <h2 class="mt-4 font-display text-3xl font-bold">{video.title}</h2>
        <p class="mt-4 text-muted">{video.description}</p>
      </div>
      <OfficialVideo videoId={video.videoId} title={video.videoTitle} />
    </section>
  )}

  {guideCards.length > 0 && (
    <section class="border-y border-border bg-surface-soft/55 py-16">
      <div class="shell">
        <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
          <div><p class="eyebrow">Start here</p><h2 class="mt-4 font-display text-3xl font-bold">Find the right kind of help</h2></div>
          <a class="text-sm font-bold text-primary" href="/guides/">View all published guides →</a>
        </div>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {guideCards.map((card) => (
            <a class="site-card guide-card flex min-h-56 flex-col p-5 no-underline" href={card.href}>
              <span class="text-xs font-bold uppercase tracking-wider text-primary">{card.label}</span>
              <h3 class="mt-3 font-display text-xl font-bold">{card.title}</h3>
              <p class="mt-3 text-sm text-muted">{card.text}</p>
              <span class="mt-auto pt-5 text-sm font-bold text-primary">Open →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {compare?.title && (
    <section class="shell py-16">
      <div class="max-w-2xl">
        <p class="eyebrow">{compare.eyebrow}</p>
        <h2 class="mt-4 font-display text-3xl font-bold">{compare.title}</h2>
        <p class="mt-4 text-muted">{compare.description}</p>
        <a class="mt-5 inline-block font-bold text-primary" href={compare.link.href}>{compare.link.label} →</a>
      </div>
    </section>
  )}

  {stats.items.length > 0 && (
    <section class="border-y border-border bg-surface-soft/55 py-16">
      <div class="shell grid gap-10 lg:grid-cols-[1fr_.9fr]">
        <div>
          <p class="eyebrow">Verified facts</p>
          <h2 class="mt-4 font-display text-3xl font-bold">{stats.title}</h2>
        </div>
        <div class="site-card p-6">
          <dl class="mt-1 grid gap-4 sm:grid-cols-2">
            {stats.items.map((item) => (
              <div><dt class="text-xs text-muted">{item.label}</dt><dd class="font-bold">{item.value}</dd></div>
            ))}
          </dl>
          <p class="mt-5 text-xs text-muted">{stats.note}</p>
        </div>
      </div>
    </section>
  )}

  {screenshots.items.length > 0 && (
    <section class="shell py-16">
      <div class="max-w-2xl">
        <p class="eyebrow">{screenshots.eyebrow}</p>
        <h2 class="mt-4 font-display text-3xl font-bold">{screenshots.title}</h2>
        <p class="mt-3 text-muted">{screenshots.description}</p>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {screenshots.items.map((img) => (
          <figure class="site-card media-card overflow-hidden"><img src={img.src} alt={img.alt} width="1280" height="720" loading="lazy" decoding="async" class="block aspect-video w-full object-cover" /><figcaption class="p-3 text-xs text-muted">{img.caption}</figcaption></figure>
        ))}
      </div>
      <p class="mt-4 text-xs text-muted">{screenshots.credit}</p>
    </section>
  )}

  <section class="shell pb-8">
    <div class="site-card grid gap-6 p-6 md:grid-cols-[1fr_auto] md:items-center md:p-8">
      <div><h2 class="font-display text-2xl font-bold">{bottomCta.title}</h2><p class="mt-2 text-muted">{bottomCta.text}</p></div>
      <a class="btn-secondary" href={bottomCta.button.href}>{bottomCta.button.label}</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Homepage visual treatment: compact field-guide layout from the approved UI preview. */
  :global(main#main-content > section:first-child) { max-width:1180px; width:calc(100vw - 2rem); margin:28px auto 14px; min-height:430px; border:1px solid var(--color-border); border-radius:14px; overflow:hidden; position:relative; background:linear-gradient(90deg,rgba(8,13,18,.97),rgba(8,13,18,.78) 43%,rgba(8,13,18,.15)),url('/media/game-active-matter-header-01.webp') center/cover; }
  :global(main#main-content > section:first-child > div:first-child) { position:relative; z-index:1; padding:74px 58px; max-width:650px; }
  :global(main#main-content > section:first-child > aside) { display:none; }
  :global(main#main-content > section:first-child .eyebrow) { color:var(--color-accent); border:0; background:none; padding:0; letter-spacing:.16em; }
  :global(main#main-content > section:first-child h1) { font-size:clamp(42px,7vw,78px); line-height:.98; letter-spacing:-.04em; margin:16px 0; }
  :global(main#main-content > section:first-child h1 span) { color:var(--color-primary); }
  :global(main#main-content > .home-facts) { max-width:1180px; width:calc(100vw - 2rem); margin:0 auto 30px; display:grid; grid-template-columns:repeat(3,1fr); gap:12px; }
  :global(.home-facts > div) { background:var(--color-surface); border:1px solid var(--color-border); border-radius:10px; padding:18px 20px; }
  :global(.home-facts strong) { display:block; font-family:var(--font-display); font-size:25px; line-height:1.15; color:var(--color-primary); }
  :global(.home-facts span) { display:block; margin-top:5px; color:var(--color-muted); font-size:13px; line-height:1.4; }
  :global(main#main-content > .home-video-section) { display:none; }
  :global(main#main-content > section:nth-of-type(4)) { padding-top:0; }
  :global(main#main-content > section:nth-of-type(4) .guide-card) { min-height:172px; border-radius:10px; }
  :global(main#main-content > section:nth-of-type(4) .guide-card p) { display:none; }
  :global(main#main-content > section:nth-of-type(4) .guide-card:before) { content:''; display:block; height:82px; margin:-1.25rem -1.25rem 1rem; background:center/cover; }
  :global(main#main-content > section:nth-of-type(4) .guide-card:nth-child(1):before) { background-image:url('/media/scene-night-road-01.webp'); }
  :global(main#main-content > section:nth-of-type(4) .guide-card:nth-child(2):before) { background-image:url('/media/scene-urban-anomaly-01.webp'); }
  :global(main#main-content > section:nth-of-type(4) .guide-card:nth-child(3):before) { background-image:url('/media/scene-red-zone-combat-01.webp'); }
  :global(main#main-content > section:nth-of-type(4) .guide-card:nth-child(4):before) { background-image:url('/media/region-park-01.webp'); }
  @media (max-width:780px) { :global(main#main-content > section:first-child > div:first-child){padding:54px 24px} :global(main#main-content > .home-facts){grid-template-columns:1fr;gap:10px} :global(.home-facts > div){padding:15px 18px} :global(main#main-content > section:nth-of-type(4) .guide-card:before){height:108px} }
</style>
