---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TableOfContents from '../components/TableOfContents.astro';
import SourceBlock from '../components/SourceBlock.astro';
import OfficialVideo from '../components/OfficialVideo.astro';
import site from '../data/site.json';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({ params: { slug: guide.data.slug }, props: { guide } }));
}
const { guide } = Astro.props;
const { Content, headings } = await render(guide);
const { title, description, category, sources, related, faq, verifiedDate, versionNote, heroImage, heroAlt, officialVideoId, officialVideoTitle } = guide.data;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3).map((h) => ({ id: h.slug, text: h.text, level: h.depth as 2 | 3 }));
const schemas: Record<string, unknown>[] = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: title, description, dateModified: new Date(verifiedDate).toISOString().slice(0, 10), mainEntityOfPage: canonical, author: { '@type': 'Organization', name: site.siteName }, publisher: { '@type': 'Organization', name: site.siteName, url: site.siteUrl } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: `${site.siteUrl}/guides/` },
    { '@type': 'ListItem', position: 3, name: title, item: canonical },
  ] },
];
if (faq.length) schemas.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) });
---
<BaseLayout title={title} description={description} ogType="article" jsonLd={schemas}>
  <div class="shell py-10 lg:flex lg:gap-12">
    <article class="min-w-0 flex-1">
      <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Guides', href: '/guides/' }, { label: title }]} />
      <p class="eyebrow">{category}</p>
      <h1 class="mt-4 max-w-4xl font-display text-4xl font-bold leading-tight sm:text-5xl">{title}</h1>
      <p class="mt-4 max-w-3xl text-lg text-muted">{description}</p>
      <div class="status-note mt-6 rounded-r-lg p-4 text-sm"><strong>Version note:</strong> {versionNote}</div>
      {heroImage && <figure class="mt-8"><div class="media-frame"><img src={heroImage} alt={heroAlt ?? ''} width="1280" height="720" loading="eager" decoding="async" /></div><figcaption class="mt-2 text-xs text-muted">Official screenshot from the Steam store page. © {site.developer}.</figcaption></figure>}
      {officialVideoId && officialVideoTitle && <OfficialVideo videoId={officialVideoId} title={officialVideoTitle} />}
      <div class="article-body mt-10 max-w-3xl"><Content /></div>
      {faq.length > 0 && <section class="mt-12"><h2 class="font-display text-2xl font-bold">Frequently asked questions</h2><div class="mt-4">{faq.map((item) => <details class="hint"><summary>{item.question}</summary><p class="mt-3 text-sm text-muted">{item.answer}</p></details>)}</div></section>}
      <SourceBlock sources={sources} verifiedDate={verifiedDate} />
      {related.length > 0 && <section class="mt-12 border-t border-border pt-8"><h2 class="font-display text-2xl font-bold">Related guides</h2><div class="mt-4 grid gap-3 sm:grid-cols-2">{related.map((item) => <a class="site-card guide-card p-4 font-bold no-underline" href={item.href}>{item.title} →</a>)}</div></section>}
    </article>
    {tocItems.length > 2 && <TableOfContents items={tocItems} />}
  </div>
</BaseLayout>
