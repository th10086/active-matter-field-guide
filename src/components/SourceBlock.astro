---
interface Source {
  label: string;
  url: string;
  type: 'official' | 'community' | 'walkthrough' | 'video';
}
const { sources, verifiedDate } = Astro.props as { sources: Source[]; verifiedDate: Date };
---

<section class="source-list site-card mt-12 p-5" aria-labelledby="sources-heading">
  <h2 id="sources-heading" class="font-display text-xl font-bold">Sources used for this guide</h2>
  <ul class="mt-3 grid gap-2 pl-5 text-sm">
    {sources.map((source) => (
      <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a> <span class="text-muted">({source.type})</span></li>
    ))}
  </ul>
  <p class="mt-4 text-xs text-muted">Guide steps last checked: {verifiedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}.</p>
</section>
