---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from './Breadcrumb.astro';
import site from '../data/site.json';
interface Props { title: string; description: string; updated?: string; }
const { title, description, updated = site.verifiedDate } = Astro.props;
---
<BaseLayout title={`${title} | ${site.siteName}`} description={description}>
  <div class="prose-shell py-12 md:py-16">
    <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: title }]} />
    <p class="eyebrow">Site information</p>
    <h1 class="mt-4 font-display text-4xl font-bold leading-tight">{title}</h1>
    <p class="mt-4 text-lg text-muted">{description}</p>
    <p class="mt-2 text-xs text-muted">Last updated: {updated}</p>
    <div class="article-body mt-10"><slot /></div>
  </div>
</BaseLayout>
