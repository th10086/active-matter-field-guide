---
import site from '../data/site.json';
---

<footer class="mt-20 border-t border-border bg-surface">
  <div class="shell grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <h2 class="font-display text-lg font-bold">{site.siteName}</h2>
      <p class="mt-2 max-w-md text-sm text-muted">{site.tagline}. This site is independent and is not affiliated with {site.developer} or Valve.</p>
    </div>
    <div>
      <h2 class="text-xs font-bold uppercase tracking-[.14em] text-muted">Site</h2>
      <ul class="mt-3 grid list-none gap-2 p-0 text-sm">
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/sources/">Sources & Image Credits</a></li>
        <li><a href="/disclaimer/">Disclaimer</a></li>
      </ul>
    </div>
    <div>
      <h2 class="text-xs font-bold uppercase tracking-[.14em] text-muted">Official links</h2>
      <ul class="mt-3 grid list-none gap-2 p-0 text-sm">
        <li><a href={site.officialUrl} rel="noopener noreferrer" target="_blank">Official game website</a></li>
        <li><a href={site.steamUrl} rel="noopener noreferrer" target="_blank">Steam store</a></li>
        <li><a href={site.communityUrl} rel="noopener noreferrer" target="_blank">Steam Community</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-border">
    <div class="shell flex flex-col gap-2 py-5 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} {site.siteName}. Original site text and design.</p>
      <p><a href="/privacy-policy/">Privacy</a> · <a href="/terms/">Terms</a></p>
    </div>
  </div>
</footer>
