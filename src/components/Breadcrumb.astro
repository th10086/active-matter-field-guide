---
interface Crumb { label: string; href?: string; }
const { crumbs } = Astro.props as { crumbs: Crumb[] };
---
<nav class="mb-6 flex min-w-0 flex-wrap items-center gap-2 text-sm text-muted" aria-label="Breadcrumb">
  {crumbs.map((crumb, index) => (
    <span class="flex min-w-0 items-center gap-2 [overflow-wrap:anywhere]">
      {index > 0 && <span aria-hidden="true">/</span>}
      {crumb.href ? <a class="hover:text-primary" href={crumb.href}>{crumb.label}</a> : <span>{crumb.label}</span>}
    </span>
  ))}
</nav>
